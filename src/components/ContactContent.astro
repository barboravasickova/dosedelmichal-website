---
import ListingHero from './ListingHero.astro';
import { contactEmail, businessInfo } from '../lib/site';
import { absolutePageUrl } from '../lib/domains';
import { contactPath, contactStrings } from '../lib/contact';
import { privacyPath } from '../lib/privacy';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
	sent?: boolean;
}

const { locale, sent = false } = Astro.props;
const copy = contactStrings(locale);
const formAction = `https://formsubmit.co/${encodeURIComponent(contactEmail)}`;
const formNext = `${absolutePageUrl(locale, contactPath(locale))}?sent=1`;
const { quick, inquiry } = copy;
const contactImageSrc = '/images/kontakt-mural.png';
---

<div class="contact-page">
	{
		sent && (
			<p class="contact-page__success" role="status">
				{copy.sentMessage}
			</p>
		)
	}

	<ListingHero title={quick.heading}>
		<p class="listing-hero__lead">
			{quick.body}{' '}
			<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
		</p>
	</ListingHero>

	<div class="contact-page__layout">
		<div class="contact-page__main">
			<section class="contact-block contact-block--form" aria-labelledby="contact-inquiry-heading">
				<h2 id="contact-inquiry-heading" class="contact-block__heading">{inquiry.heading}</h2>
				<p class="contact-block__body">{inquiry.body}</p>

				<form
					class="contact-form"
					action={formAction}
					method="post"
					enctype="multipart/form-data"
				>
					<input type="hidden" name="_subject" value={copy.formSubject} />
					<input type="hidden" name="_next" value={formNext} />
					<input type="hidden" name="_template" value="table" />
					<input type="text" name="_honey" class="contact-form__honey" tabindex="-1" autocomplete="off" />

					<div class="contact-form__field">
						<label for="contact-name">{inquiry.fields.name}</label>
						<input id="contact-name" name="name" type="text" required autocomplete="name" />
					</div>

					<div class="contact-form__field">
						<label for="contact-email">{inquiry.fields.email}</label>
						<input
							id="contact-email"
							name="email"
							type="email"
							required
							autocomplete="email"
							inputmode="email"
						/>
					</div>

					<div class="contact-form__field">
						<label for="contact-location">{inquiry.fields.location}</label>
						<input
							id="contact-location"
							name="location"
							type="text"
							required
							placeholder={inquiry.fields.locationPlaceholder}
						/>
					</div>

					<div class="contact-form__field">
						<label for="contact-description">{inquiry.fields.description}</label>
						<textarea id="contact-description" name="description" rows={6} required></textarea>
					</div>

					<div class="contact-form__field">
						<label for="contact-attachment">{inquiry.fields.attachment}</label>
						<p class="contact-form__hint">{inquiry.fields.attachmentHint}</p>
						<input id="contact-attachment" name="attachment" type="file" accept="image/*,.pdf" />
					</div>

					<button class="contact-form__submit" type="submit">{inquiry.submit}</button>
				</form>

				<p class="contact-form__privacy">
					{copy.formPrivacy.lead}{' '}
					<a href={privacyPath(locale)}>{copy.formPrivacy.linkLabel}</a>.
				</p>

				<div class="contact-billing">
					<h3 class="contact-billing__heading">{copy.billing.heading}</h3>
					<dl class="contact-billing__list">
						<div class="contact-billing__row">
							<dt class="contact-billing__sr-only">{copy.billing.nameLabel}</dt>
							<dd>{businessInfo.fullName}</dd>
						</div>
						<div class="contact-billing__row">
							<dt class="contact-billing__sr-only">{copy.billing.addressSrLabel}</dt>
							<dd>{businessInfo.address}</dd>
						</div>
						<div class="contact-billing__row">
							<dt class="contact-billing__sr-only">{copy.billing.icoSrLabel}</dt>
							<dd>IČO: {businessInfo.ico}</dd>
						</div>
						<div class="contact-billing__row contact-billing__row--status">
							<dt class="contact-billing__sr-only">{copy.billing.legalStatus}</dt>
							<dd>{copy.billing.legalStatus}</dd>
						</div>
					</dl>
				</div>
			</section>
		</div>

		<figure class="contact-page__figure">
			<img
				class="contact-page__photo"
				src={contactImageSrc}
				alt={copy.imageAlt}
				width={428}
				height={858}
				loading="lazy"
				decoding="async"
				data-photo-palette-source
			/>
		</figure>
	</div>
</div>
