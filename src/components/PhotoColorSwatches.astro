---
interface Props {
	theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;

const fallbackHex = ['#181818', '#383838', '#606060', '#989898', '#e3e1da'];
---

<div
	class:list={['photo-palette', theme === 'dark' && 'photo-palette--dark']}
	data-photo-palette
	aria-hidden="true"
>
	{
		fallbackHex.map((hex) => (
			<span class="photo-palette__swatch" style={{ backgroundColor: hex }}></span>
		))
	}
</div>

<script>
	import { initPhotoPalette } from '../lib/photoColorPalette';

	initPhotoPalette(document.querySelector('[data-photo-palette]'));
</script>
