---
import { aboutContent, aboutPortraitSrc } from '../lib/about';
import type { Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const content = aboutContent(locale);
---

<div class="about-page">
	<div class="about-page__layout">
		<div class="about-page__copy">
			<h2 class="about-page__title"><strong>{content.title}</strong></h2>
			<div class="about-page__prose">
				{content.paragraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</div>
			{
				content.exhibitions.length > 0 && (
					<section class="about-page__exhibitions" aria-labelledby="about-exhibitions-heading">
						<h3 id="about-exhibitions-heading" class="about-page__exhibitions-heading">
							{content.exhibitionsHeading}
						</h3>
						<ul class="about-page__exhibitions-list">
							{content.exhibitions.map((entry) => (
								<li>
									{entry.year} —{' '}
									{
										entry.href ? (
											<a
												class="about-page__exhibitions-link"
												href={entry.href}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={entry.linkAriaLabel ?? entry.title}
											>
												<strong class="about-page__exhibitions-title">{entry.title}</strong>
											</a>
										) : (
											<strong class="about-page__exhibitions-title">{entry.title}</strong>
										)
									}
									, {entry.detail}
								</li>
							))}
						</ul>
					</section>
				)
			}
		</div>
		<figure class="about-page__figure">
			<img
				class="about-page__photo"
				src={aboutPortraitSrc}
				alt={content.portraitAlt}
				width="640"
				height="640"
				loading="lazy"
				decoding="async"
				data-photo-palette-source
			/>
		</figure>
	</div>
</div>
