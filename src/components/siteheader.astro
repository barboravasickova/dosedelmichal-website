---
import { alternateLocaleUrl } from '../lib/domains';
import { homePath, navItems, type Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
	currentPath: string;
	theme?: 'dark' | 'light';
	width?: 'full' | 'contained';
}

const { locale, currentPath, theme = 'light', width = 'contained' } = Astro.props;
const items = navItems(locale);
const csPath = alternateLocaleUrl(currentPath, 'cs');
const enPath = alternateLocaleUrl(currentPath, 'en');
const logoSrc = theme === 'light' ? '/images/dose-logo-dark.svg' : '/images/dose-logo.svg';
const menuLabel = locale === 'cs' ? 'Otevřít menu' : 'Open menu';
const closeLabel = locale === 'cs' ? 'Zavřít menu' : 'Close menu';

function isActive(href: string) {
	const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
	const target = href.replace(/\/+$/, '') || '/';
	if (path === target) return true;
	if (target === '/en' && path === '/') return true;
	if (target === '/cs/zakazkova-malba' && path.startsWith('/cs/zakazkova-malba/')) return true;
	if (target === '/en/commissions' && path.startsWith('/en/commissions/')) return true;
	return false;
}
---

<header
	class:list={[
		'site-header',
		theme === 'light' ? 'site-header--light' : 'site-header--dark',
		width === 'full' ? 'site-header--full' : 'site-header--contained',
	]}
	data-site-header
>
	<div class="site-header__inner">
		<a class="site-header__logo" href={homePath(locale)} aria-label="DOSE — domů">
			<img src={logoSrc} width="96" height="35" alt="DOSE" />
		</a>

		<nav
			class="site-header__nav"
			id="site-header-nav"
			data-site-nav
			data-nav-theme={theme}
			aria-label={locale === 'cs' ? 'Hlavní menu' : 'Main menu'}
		>
			<button
				type="button"
				class="site-header__nav-close"
				data-site-nav-close
				aria-label={closeLabel}
			>
				<span class="site-header__nav-close-icon" aria-hidden="true"></span>
			</button>
			{
				items.map(({ href, label }) => (
					<a href={href} aria-current={isActive(href) ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>

		<div class="site-header__actions">
			<div class="site-header__lang" aria-label={locale === 'cs' ? 'Jazyk' : 'Language'}>
				<a href={csPath} aria-current={locale === 'cs' ? 'true' : undefined}>
					CZ
				</a>
				<span aria-hidden="true">|</span>
				<a href={enPath} aria-current={locale === 'en' ? 'true' : undefined}>
					EN
				</a>
			</div>

			<button
				type="button"
				class="site-header__toggle"
				data-site-nav-toggle
				aria-controls="site-header-nav"
				aria-expanded="false"
				aria-label={menuLabel}
				data-label-open={menuLabel}
				data-label-close={closeLabel}
			>
				<span class="site-header__toggle-box" aria-hidden="true">
					<span class="site-header__toggle-line"></span>
					<span class="site-header__toggle-line"></span>
					<span class="site-header__toggle-line"></span>
				</span>
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-site-nav-toggle]');
	const navClose = document.querySelector<HTMLButtonElement>('[data-site-nav-close]');
	const nav = document.querySelector<HTMLElement>('[data-site-nav]');

	if (header && toggle && nav) {
		const mq = matchMedia('(max-width: 900px)');

		let scrollLockY = 0;
		let navAnchor: Comment | null = null;

		const navParent = nav.parentElement;

		const mountNavOverlay = () => {
			if (nav.parentElement === document.body || !navParent) return;
			navAnchor = document.createComment('site-nav-anchor');
			navParent.insertBefore(navAnchor, nav);
			document.body.appendChild(nav);
		};

		const unmountNavOverlay = () => {
			if (nav.parentElement !== document.body || !navParent) return;
			if (navAnchor) {
				navParent.insertBefore(nav, navAnchor);
				navAnchor.remove();
				navAnchor = null;
			} else {
				navParent.appendChild(nav);
			}
		};

		const lockScroll = () => {
			scrollLockY = window.scrollY;
			document.body.style.position = 'fixed';
			document.body.style.top = `-${scrollLockY}px`;
			document.body.style.left = '0';
			document.body.style.right = '0';
			document.body.classList.add('is-nav-locked');
		};

		const unlockScroll = () => {
			document.body.classList.remove('is-nav-locked');
			document.body.style.position = '';
			document.body.style.top = '';
			document.body.style.left = '';
			document.body.style.right = '';
			window.scrollTo(0, scrollLockY);
		};

		const setOpen = (open: boolean) => {
			const mobile = mq.matches;
			const wasOpen = header.classList.contains('is-nav-open');

			if (open && mobile && !wasOpen) {
				mountNavOverlay();
				lockScroll();
			}
			if (!open && mobile && wasOpen) {
				unmountNavOverlay();
				unlockScroll();
			}

			header.classList.toggle('is-nav-open', open);
			nav.classList.toggle('is-nav-open', open);
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute(
				'aria-label',
				open ? (toggle.dataset.labelClose ?? 'Close menu') : (toggle.dataset.labelOpen ?? 'Open menu'),
			);
		};

		toggle.addEventListener('click', () => {
			setOpen(!header.classList.contains('is-nav-open'));
		});

		navClose?.addEventListener('click', () => setOpen(false));

		nav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		mq.addEventListener('change', () => {
			if (!mq.matches) {
				unmountNavOverlay();
				if (header.classList.contains('is-nav-open')) unlockScroll();
				setOpen(false);
			}
		});

		const scrollThreshold = 12;
		const updateScrolled = () => {
			if (!mq.matches) {
				header.classList.remove('is-scrolled');
				return;
			}
			header.classList.toggle('is-scrolled', window.scrollY > scrollThreshold);
		};

		window.addEventListener('scroll', updateScrolled, { passive: true });
		mq.addEventListener('change', updateScrolled);
		updateScrolled();
	}
</script>
