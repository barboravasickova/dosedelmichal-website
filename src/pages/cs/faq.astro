---
import FaqList from '../../components/FaqList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { faqSections } from '../../lib/faq';
import { pageTitle } from '../../lib/i18n';

const locale = 'cs';
const currentPath = '/cs/faq';
---

<PageLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, 'FAQ')}
	description="Často kladené otázky — Michal Doseděl."
	heading="FAQ"
>
	<FaqList sections={faqSections(locale)} />
</PageLayout>
