---
import PageLayout from '../../layouts/PageLayout.astro';
import { pageTitle, uiStrings } from '../../lib/i18n';
import { contactEmail, social } from '../../lib/site';

const locale = 'cs';
const currentPath = '/cs/kontakt';
const ui = uiStrings(locale);
---

<PageLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, 'Kontakt')}
	description="Kontakt — Michal Doseděl."
>
	<div class="contact-page">
		<p class="contact-page__heading">{ui.footerContactHeading}</p>
		<p class="contact-page__location">{ui.location}</p>
		<a class="contact-page__email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
		<p class="contact-page__follow">{ui.footerFollow}</p>
		<ul class="contact-page__social">
			<li>
				<a href={social.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
			</li>
			<li>
				<a href={social.facebook} rel="noopener noreferrer" target="_blank">Facebook</a>
			</li>
		</ul>
	</div>
</PageLayout>
