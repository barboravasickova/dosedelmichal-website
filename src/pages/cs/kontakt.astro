---
import ContactContent from '../../components/ContactContent.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { pageTitle } from '../../lib/i18n';

const locale = 'cs';
const currentPath = '/cs/kontakt';
const sent = Astro.url.searchParams.get('sent') === '1';
---

<PageLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, 'Kontakt')}
	description="Kontakt — Michal Doseděl."
>
	<ContactContent locale={locale} sent={sent} />
</PageLayout>
