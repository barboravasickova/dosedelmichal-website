---
import ShopContent from '../../components/ShopContent.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { pageTitle } from '../../lib/i18n';
import { shopProducts } from '../../lib/shop';

const locale = 'cs';
const currentPath = '/cs/shop';
const products = shopProducts(locale);
---

<PageLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, 'Shop')}
	description="Shop — Michal Doseděl."
>
	<ShopContent products={products} locale={locale} />
</PageLayout>
