---
import ProjectDetailContent from '../../../components/projectdetailcontent.astro';
import ProjectDetailLayout from '../../../layouts/projectdetaillayout.astro';
import { pageTitle } from '../../../lib/i18n';
import { commissionProjects } from '../../../lib/projects';
import { projectMetaDescription } from '../../../lib/seo';

export function getStaticPaths() {
	return commissionProjects('en').map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const locale = 'en';
const { project } = Astro.props;
const currentPath = `/en/commissions/${project.slug}`;
---

<ProjectDetailLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, project.title)}
	description={projectMetaDescription(project)}
	ogImage={project.heroImage}
>
	<ProjectDetailContent locale={locale} project={project} />
</ProjectDetailLayout>
