---
import FaqList from '../../components/faqlist.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { faqListHero, faqSections } from '../../lib/faq';
import { pageTitle } from '../../lib/i18n';

const locale = 'en';
const currentPath = '/en/faq';
const { subtitle: description } = faqListHero(locale);
---

<PageLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, 'FAQ')}
	description={description}
>
	<FaqList locale={locale} sections={faqSections(locale)} />
</PageLayout>
