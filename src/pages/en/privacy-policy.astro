---
import PrivacyContent from '../../components/PrivacyContent.astro';
import PageLayout from '../../layouts/pagelayout.astro';
import { privacyPageContent } from '../../lib/privacy';
import { pageTitle } from '../../lib/i18n';

const locale = 'en';
const currentPath = '/en/privacy-policy';
const { title } = privacyPageContent(locale);
---

<PageLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale, title)}
	description="Personal data processing — Michal Doseděl."
	heading={title}
>
	<PrivacyContent locale={locale} />
</PageLayout>
