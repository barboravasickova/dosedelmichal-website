---
import HomeLayout from '../layouts/HomeLayout.astro';
import { czechDevRootRedirectScript } from '../lib/domains';
import { pageTitle } from '../lib/i18n';

const locale = 'en';
const currentPath = '/en/';
---

<HomeLayout
	locale={locale}
	currentPath={currentPath}
	title={pageTitle(locale)}
	description="DOSE — Michal Doseděl. Painter and graffiti artist portfolio."
	inlineHeadScript={czechDevRootRedirectScript()}
	canonicalUrl="https://dosedelmichal.com/en/"
/>
