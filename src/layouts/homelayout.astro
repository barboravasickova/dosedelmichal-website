---
import BackToTop from '../components/BackToTop.astro';
import PhotoColorSwatches from '../components/PhotoColorSwatches.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	currentPath: string;
	inlineHeadScript?: string;
	canonicalUrl?: string;
}

const { locale, title, description, currentPath, inlineHeadScript, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		{inlineHeadScript && <script is:inline set:html={inlineHeadScript} />}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#181818" />
		<SeoHead
			locale={locale}
			title={title}
			description={description}
			currentPath={currentPath}
			canonicalUrl={canonicalUrl}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="hero">
			<div class="hero__bg" aria-hidden="true">
				<video
					class="hero__bg-video"
					src="/images/dose-video.webm"
					autoplay
					muted
					loop
					playsinline
					preload="auto"
				></video>
			</div>

			<SiteHeader locale={locale} currentPath={currentPath} theme="dark" width="contained" />

			<main class="hero__main">
				<div class="hero__wordmark" role="img" aria-label="Michal Dose Doseděl">
					<img src="/images/hero-wordmark.svg" width="435" height="485" alt="" decoding="async" />
				</div>
			</main>
		</div>
		<PhotoColorSwatches theme="dark" />
		<BackToTop locale={locale} theme="dark" />
		<script>
			const heroVideo = document.querySelector<HTMLVideoElement>('.hero__bg-video');
			if (!heroVideo) throw new Error('Hero video missing');

			heroVideo.muted = true;
			const tryPlay = () => {
				void heroVideo.play().catch(() => {
					/* autoplay can be blocked; muted loop usually recovers on interaction */
				});
			};

			if (heroVideo.readyState >= 2) tryPlay();
			else heroVideo.addEventListener('loadeddata', tryPlay, { once: true });
		</script>
	</body>
</html>
