---
import BackToTop from '../components/BackToTop.astro';
import PhotoColorSwatches from '../components/PhotoColorSwatches.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	currentPath: string;
}

const { locale, title, description, currentPath } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#181818" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="hero">
			<div class="hero__bg" aria-hidden="true">
				<img
					src="/images/homepage-hero.jpg"
					alt=""
					width="1920"
					height="1280"
					fetchpriority="high"
					data-photo-palette-source
				/>
			</div>

			<SiteHeader locale={locale} currentPath={currentPath} theme="dark" width="contained" />

			<main class="hero__main">
				<div class="hero__wordmark" role="img" aria-label="Michal Dose Doseděl">
					<img src="/images/hero-wordmark.svg" width="435" height="485" alt="" decoding="async" />
				</div>
			</main>

			<SiteFooter locale={locale} variant="minimal" />
		</div>
		<PhotoColorSwatches theme="dark" />
		<BackToTop locale={locale} theme="dark" />
	</body>
</html>
